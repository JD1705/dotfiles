# ~/.config/betterlockscreenrc
# ======================

# default options
display_on=0
span_image=false
lock_timeout=300
fx_list=(dim blur dimblur pixel dimpixel color)
dim_level=40
blur_level=1
pixel_scale=10,1000
solid_color=1e1e2e
wallpaper_cmd="feh --bg-fill"
quiet=false

# Catppuccin Mocha theme
loginbox=18182522
loginshadow=00000000
locktext="Type password to unlock..."
font="firacode"
ringcolor=cdd6f466
insidecolor=1e1e2eff
separatorcolor=b4befe00
ringvercolor=89b4faff
insidevercolor=89b4fa66
ringwrongcolor=f38ba8ff
insidewrongcolor=f38ba866
timecolor=cdd6f4ff
time_format="%H:%M"
greetercolor=cdd6f4ff
layoutcolor=cdd6f4ff
keyhlcolor=89dcebff
bshlcolor=f38ba8ff
veriftext="Verifying..."
verifcolor=89b4faff
wrongtext="Failure!"
wrongcolor=f38ba8ff
modifcolor=fab387ff
bgcolor=1e1e2eff


#
# expert options (change at own risk!)
#

# i3lockcolor_bin="i3lock-color"      # Manually set command for i3lock-color
# suspend_command="systemctl suspend" # Manually change action e.g. hibernate/suspend-command

# i3lock-color - custom arguments
