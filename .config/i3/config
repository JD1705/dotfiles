# Gaps entre ventanas
gaps inner 5
gaps outer 2

gaps top 27
gaps bottom 24
# Colores Kanagawa Dragon
# Definición de colores Catppuccin Mocha
set $bg       #1e1e2e
set $text     #cdd6f4
set $blue     #89b4fa
set $surface0 #313244
set $red      #f38ba8

# Colores de ventanas:   borde    fondo    texto    indicador  borde_hijo
client.focused          $blue    $blue    $bg      $blue      $blue
client.focused_inactive $surface0 $bg      $text    $surface0  $surface0
client.unfocused        $surface0 $bg      $text    $surface0  $surface0
client.urgent           $red     $red     $bg      $red       $red

for_window [class="firefox"] border pixel 1
for_window [class="Mate-terminal"] border pixel 1
for_window [floating] border pixel 1

default_border pixel 1

for_window [class="floating_playlist"] floating enable, move position mouse, resize set 400 300

#######################################################################
# automatically start i3-config-wizard to offer the user to create a
# keysym-based config which used their favorite modifier (alt or windows)
#
# i3-config-wizard will not launch if there already is a config file
# in ~/.config/i3/config (or $XDG_CONFIG_HOME/i3/config if set) or
# ~/.i3/config.
#
# Please remove the following exec line:
#######################################################################
exec_always --no-startup-id picom -b
exec_always feh --bg-fill ~/walls-catppuccin-mocha/cat-vibin.png
#exec_always --no-startup-id ~/.config/i3/wallpaper.sh
exec_always --no-startup-id setxkbmap -option caps:escape
exec_always --no-startup-id bash -c 'sleep 1 && xmodmap -e "keycode 127 = Caps_Lock" -e "add lock = Caps_Lock"'
exec --no-startup-id /usr/bin/dunst
