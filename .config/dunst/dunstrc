[global]
width = (0, 300)
height = 300
notification_limit = 5
origin = top-right
separator_height = 2
frame_width = 2
gap_size = 6
sort = true
font = "FiraCode Nerd Font 9"
icon_theme = "Papirus-Dark"
corner_radius = 12
enable_recursive_icon_lookup = true
max_icon_size = 16
icon_path = /usr/share/icons/Papirus-Dark/8x8/

[urgency_low]
# Tono Surface0 con transparencia tenue y borde Surface2
background = "#1e1e2ecc"
foreground = "#a6adc8"
frame_color = "#585b70"
timeout = 5

[urgency_normal]
# Fondo Base oscuro y transparente con borde Blue (Acento principal)
background = "#1e1e2edd"
foreground = "#cdd6f4"
highlight = "#89b4fa"
frame_color = "#89b4fa"
timeout = 8

[urgency_critical]
# Fondo Base con borde Red (Urgencia) y texto Peach
background = "#1e1e2eee"
foreground = "#fab387"
frame_color = "#f38ba8"
timeout = 0
